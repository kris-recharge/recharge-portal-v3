# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# ── Email (Microsoft 365 SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@rechargealaska.net
SMTP_PASSWORD=<password-or-app-password>
ALERT_EMAIL_TO=info@rechargealaska.net
ALERT_EMAIL_FROM=info@rechargealaska.net

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate ONCE with:  docker exec rca_api_v3 python -m app.push --generate-keys
# Then paste the output here and restart the API. Keep the same keys forever:
# rotating them invalidates every device subscription already registered, and
# each user has to tap "Enable Notifications" again.
# Leave blank to keep push disabled (alerts fall back to email only).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@rechargealaska.net

# ── App ───────────────────────────────────────────────────────────────────────
APP_MODE=web
# APP_ENV gates the auth bypass. Leave as "production" on the server. The bypass
# below is honoured ONLY when APP_ENV=development, so a stray DEV_BYPASS_AUTH=true
# cannot disable Supabase auth / per-user EVSE filtering in production.
APP_ENV=production
SECRET_KEY=<openssl rand -hex 32>
ALLOWED_ORIGINS=http://localhost:5173,https://dashboard.rechargealaska.net
# ── Local development only ────────────────────────────────────────────────────
# To skip Supabase auth on the API locally, set BOTH of these (never in prod):
#   APP_ENV=development
#   DEV_BYPASS_AUTH=true
